programa
{
	
	funcao inicio()
	{
		real a, b, soma
		escreva("Digite o primeiro número: ")
		leia(a)
		escreva("Digite o segundo número: ")
		leia(b)

		soma = a+b
		escreva("O valor da soma é ", soma)
		
	}
}
