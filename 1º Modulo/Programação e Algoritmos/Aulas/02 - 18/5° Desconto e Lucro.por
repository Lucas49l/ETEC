programa
{
	
	funcao inicio()
	{
		real x, des, lucro
		escreva("Digite um valor: ")
		leia(x)
		
		des = x-(x/100)*19
		lucro = x+(x/100)*25

		escreva("O valor com desconto de 19% é ", des)
		escreva("\nO valor com lucro de 25% é ", lucro)
		
	}
}
