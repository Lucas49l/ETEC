programa
{
	
	funcao inicio()
	{
		real lado, area, perimetro

		escreva("Digite o adodo quadrado: ")
		leia(lado)

		area = lado*lado
		perimetro = lado*4
		escreva("Àrea: ", area)
		escreva("\nPerimetro: ", perimetro)
	}
}
