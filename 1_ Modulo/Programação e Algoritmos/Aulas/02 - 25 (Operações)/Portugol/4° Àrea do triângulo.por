programa
{
	
	funcao inicio()
	{
		real base, altura, area
		escreva("Base do Triângulo: ")
		leia(base)
		escreva("Altura do triângulo")
		leia(altura)

		area = (base*altura)/2 
		escreva("Área do triangulo é: ", area)
	}
}
