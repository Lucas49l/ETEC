programa
{
	
	funcao inicio()
	{
		real altura

		escreva("Digite a altura: ")
		leia(altura)

		se(altura >= 1.50){
			escreva("A criança pode andar na montanha russa")
			
		}senao{
			escreva("A criança é pequena demais para andar na montanha russa")
		}
	}
}
