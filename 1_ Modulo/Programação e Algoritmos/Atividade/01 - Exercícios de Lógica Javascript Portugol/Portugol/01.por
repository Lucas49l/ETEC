programa
{
	
	funcao inicio()
	{
	real a, b,  resultado

	escreva(" Digite o valor de a:")
	leia(a)
	
	escreva(" Digite o valor de b:")
	leia(b)

	resultado= (a+b)*a
	escreva("O valor da conta é:", resultado)
	}
}
