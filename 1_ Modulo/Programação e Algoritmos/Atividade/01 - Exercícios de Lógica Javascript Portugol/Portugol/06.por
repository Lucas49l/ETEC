programa
{
	
	funcao inicio()
	{
	inteiro salario = 4500, bonus = 200, bugs, salariobonus
	escreva("Quantidades de Bugs resolvidos: ")
	leia(bugs)
	salariobonus = (bonus*bugs)+salario
	escreva("Salário com bonus: ", salariobonus)
	}
}
