programa
{
	
	funcao inicio()
	{
		real valor1, valor2
		escreva("Digite o 1° valor: ")
		leia(valor1)
		escreva("Digite o 2° valor: ")
		leia(valor2)
		escreva("\nSoma: ",valor1," + ",valor2," = ",valor1+valor2)
		escreva("\nSubtração: ",valor1," - ",valor2," = ",valor1-valor2)
		escreva("\nMultiplicação: ",valor1," X ",valor2," = ",valor1*valor2)
		escreva("\nDivisão: ",valor1," / ",valor2," = ",valor1/valor2)
	}
}											 			
