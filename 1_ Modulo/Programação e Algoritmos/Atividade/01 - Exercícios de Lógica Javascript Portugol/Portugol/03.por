programa
{
	
	funcao inicio()
	{
	inteiro a, b , res
	escreva("Digite o ano do seu nascimento: ")
	leia(a)
	escreva("Digite o ano atual: ")
	leia(b)
	res=b-a
	escreva("A sua idade é: ", res)
	}
}


