programa
{
	
	funcao inicio()
	{
		const inteiro secreto = 86
		inteiro numero
		logico acertou=falso
		enquanto(acertou == falso){
		    escreva("Descubra o numero secreto")
		    leia(numero)
		    se(numero == secreto){
		        acertou = verdadeiro
		    }
		}
		escreva("Acertou o numero secreto")
	}
}

