programa
{
	
	funcao inicio()
	{
		real hora,minuto
		escreva("Digite os minutos:  ")
		leia(minuto)
		hora= minuto/60
		escreva("conversão: ",minuto," min = ",hora," h")
	}
}                                              	                 
                                                             
