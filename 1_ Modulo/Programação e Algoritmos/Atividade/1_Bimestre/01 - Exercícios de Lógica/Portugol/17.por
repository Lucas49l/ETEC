programa
{
	funcao inicio()
	{
		inteiro minutos,segundos
		escreva("Digite os minutos: ")
		leia(minutos)
		segundos= minutos*60
		escreva("conversão: ",minutos," min = ",segundos," segundos")
	}
                                                                   
} 
