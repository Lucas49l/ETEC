programa
{
	funcao inicio()
	{
		const real passagem= 5.20, qntPassagem= 4.0, dias= 30.0 
		real resultado
		resultado= (passagem*qntPassagem)*dias
		escreva("O total gasto no mês com transporte é: R$ ", resultado)
	}
}
