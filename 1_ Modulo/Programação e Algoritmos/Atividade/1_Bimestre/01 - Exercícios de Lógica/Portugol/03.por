programa
{
	
	funcao inicio()
	{
	inteiro ano_Nascimento, ano_Atual , idade
	escreva("Digite o ano do seu nascimento: ")
	leia(ano_Nascimento)
	escreva("Digite o ano atual: ")
	leia(ano_Atual)
	idade = ano_Atual - ano_Nascimento 
	escreva("A sua idade é: ", idade)
	}
}


