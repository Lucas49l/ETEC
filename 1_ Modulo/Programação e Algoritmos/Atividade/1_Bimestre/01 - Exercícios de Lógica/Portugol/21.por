programa
{
	
	funcao inicio()
	{
		const real cotacao= 5.37
		real dolar, reais
		escreva("Digite o valor em Dólares: ")
		leia(dolar)
		reais = dolar*cotacao
		escreva("Conversão: $",dolar," = R$",reais)
	}
}
