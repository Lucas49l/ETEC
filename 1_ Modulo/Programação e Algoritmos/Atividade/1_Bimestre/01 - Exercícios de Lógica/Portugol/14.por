programa
{
	
	funcao inicio()
	{
		real km, metros
		escreva("Digite o comprimentro em quilometros (km): ")
		leia(km)
		metros = km*1000
		escreva("conversão: ",km," Km = ",metros," m")
		              
	}												 
}
