programa
{
	
	funcao inicio()
	{
	inteiro valor1, valor2,  resultadoFinal
	escreva(" Digite o 1° Valor:")
	leia(valor1)
	escreva(" Digite o 2° Valor:")
	leia(valor2)
	resultadoFinal= (valor1+valor2)*valor1
	escreva("O valor da conta é:", resultadoFinal)
	}
}
