programa
{
	
	funcao inicio()
	{
	real litros, mililitros
	escreva("Digite a quatidade de em (L): ")
	leia(litros)
	mililitros = litros*1000
	escreva("A quantidade de ",litros," L em Mililitros é ",mililitros," ml")
	}
}

