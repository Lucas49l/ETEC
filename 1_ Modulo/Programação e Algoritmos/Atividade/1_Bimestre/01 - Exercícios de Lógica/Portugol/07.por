programa
{
	
	funcao inicio()
	{
	const inteiro salario = 2000, bonus = 100
	inteiro automoveisVendidos, salariobonus
	escreva("Quantidades de automoveis Vendidos: ")
	leia(automoveisVendidos)
	salariobonus = (bonus*automoveisVendidos)+salario
	escreva("Salário do funcionario com bonus: ", salariobonus)
	}
}													    
