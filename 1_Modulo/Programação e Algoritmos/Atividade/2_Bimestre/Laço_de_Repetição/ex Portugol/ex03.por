programa
{
	
	funcao inicio()
	{
		inteiro numero=1, soma=0
		
		enquanto(numero != 0){
			escreva("Digite um numero")
		   	leia(numero)
		   	soma = soma+numero
		}
		escreva("\nsoma dos numeros ", soma)
		}
}
