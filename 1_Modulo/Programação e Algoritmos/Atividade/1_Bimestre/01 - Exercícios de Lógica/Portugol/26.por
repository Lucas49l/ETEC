programa
{
	
	funcao inicio()
	{
		real bonus, salario, salarioBonus
		escreva("Digite o salário: ")
		leia(salario)
		bonus = (salario/100)*10
		salarioBonus =  salario+bonus
		escreva("\nSalário: R$",salario)
		escreva("\nBonus: R$",bonus)
		escreva("\nTotal: R$",salarioBonus)
	}
}
