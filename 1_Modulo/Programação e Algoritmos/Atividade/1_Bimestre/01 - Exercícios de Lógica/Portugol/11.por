programa
{
	
	funcao inicio()
	{
	real litros, mililitros
	escreva("Digite a quatidade de em (ml): ")
	leia(mililitros)
	litros=  mililitros/1000
	escreva("A quantidade de ",mililitros," ml em litros é ",litros," L")
	}
}

