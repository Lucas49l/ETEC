programa
{
	
	funcao inicio()
	{
		real metros, centimetros

		escreva("Digite o comprimento em céntimetros(cm): ")
		leia(centimetros)
		metros= centimetros/100
		escreva(centimetros," cm = ",metros," m")
	}
}								   					
