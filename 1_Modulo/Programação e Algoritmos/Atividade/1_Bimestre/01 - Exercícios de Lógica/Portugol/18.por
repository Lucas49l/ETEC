programa
{
	funcao inicio()
	{
		inteiro minutos,segundos
		escreva("Digite os segundos: ")
		leia(segundos)
		minutos= segundos/60
		escreva("conversão: ",segundos," segundos = ",minutos," min")
	}
                                                                        
}
 
