programa
{
	
	funcao inicio()
	{	
		real AulasPrevistas, presencaMin
		escreva("Digite o total de aulas: ")
		leia(AulasPrevistas)
		presencaMin = (AulasPrevistas/100)*75
		escreva("O aluno precisa ter no minimo ",presencaMin," aulas para ser aprovado")
	}
                                  	                                                         
}
